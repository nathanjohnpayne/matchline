#!/usr/bin/env bash
# check_deploy_service_list (#441 follow-up)
#
# Every function exported from `functions/src/index.ts` must appear in
# the function-inventory table in DEPLOYMENT.md § Cloud Run IAM
# prerequisites.
#
# ## What went wrong that this catches
#
# HTTP-triggered functions need a manual `--no-invoker-iam-check` on
# first deploy: `firebase deploy` creates the Cloud Run service but
# cannot set its invoker policy. The function ships fine, the policy
# does not, and the callable then answers every browser request with a
# CORS-preflight 403 that the SDK reports as a bare `internal`. The
# documented list went stale the moment #441 added
# `deriveMatchEvidence`, and nothing noticed until the deploy failed.
#
# ## Why this checks ACCOUNTING, not trigger type
#
# Earlier versions tried to infer which exports were HTTP-triggered and
# to generate the exact remediation command. Review on PR #452 found,
# in successive rounds, that this required correctly handling: bare and
# aliased re-exports, multi-symbol and multi-line export clauses, local
# `export { foo }` with no `from`, generic calls like
# `onCall<RequestData>(...)`, per-SYMBOL trigger resolution when one
# module exports both an HTTP and an event handler, the `_` -> `-`
# service-name rule, and per-function `region` options.
#
# Each fix was correct and the next round found another valid form. The
# honest reading is that "which binding becomes which service, where"
# is the TypeScript compiler's job plus firebase-tools' naming logic,
# and approximating it in CI produced a check that was confidently
# wrong in new ways — including, at one point, advising that an
# event-triggered function be made publicly invokable.
#
# So the contract is narrowed to something a text check can actually
# guarantee: every export is ACCOUNTED FOR in the table. The trigger
# type and service name are recorded there by a human, deliberately,
# which is also where that judgement belongs. This check only enforces
# that nobody adds a function and forgets.
#
# Fails closed on a missing heading, a missing table, or zero parsed
# exports — a check that cannot see its inputs must not report OK.
#
# Portability: stock macOS Bash 3.2 + python3 (five sibling checks here
# already use python3).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

python3 - "$ROOT" <<'PY'
import os, re, sys

root = sys.argv[1]
index_path = os.path.join(root, "functions", "src", "index.ts")
doc_path = os.path.join(root, "DEPLOYMENT.md")

for p in (index_path, doc_path):
    if not os.path.isfile(p):
        sys.exit(f"check_deploy_service_list: missing {os.path.relpath(p, root)}")

def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"(?m)//.*$", "", text)

src = strip_comments(open(index_path, encoding="utf-8").read())

exports = set()
for st in (s.strip() for s in src.split(";")):
    # `export const X = ...` / `export function X(...)`
    m = re.match(r"^export\s+(?:async\s+)?(?:const|let|var|function|class)\s+([A-Za-z0-9_$]+)", st)
    if m:
        exports.add(m.group(1))
        continue
    # `export { A, B as C } [from "..."]` — with or without `from`,
    # single- or multi-line, any number of symbols.
    m = re.match(r"^export\s+(type\s+)?\{(.+?)\}", st, flags=re.S)
    if m:
        if m.group(1):
            continue                     # `export type { ... }` is not a function
        for part in m.group(2).split(","):
            part = part.strip()
            if not part or part.startswith("type "):
                continue                 # inline `type X` specifier
            alias = re.match(r"^([A-Za-z0-9_$]+)\s+as\s+([A-Za-z0-9_$]+)$", part)
            name = alias.group(2) if alias else part
            if re.match(r"^[A-Za-z0-9_$]+$", name) and name != "default":
                exports.add(name)

if not exports:
    sys.exit(
        "check_deploy_service_list: parsed no exports from "
        "functions/src/index.ts — failing rather than reporting a vacuous "
        "pass."
    )

doc = open(doc_path, encoding="utf-8").read()
HEADING = "## Cloud Run IAM prerequisites (Functions)"
if HEADING not in doc:
    sys.exit(
        f"check_deploy_service_list: '{HEADING}' not found in DEPLOYMENT.md. "
        "The inventory moved or was renamed; this check will not pass by "
        "default."
    )
section = re.split(r"(?m)^## ", doc.split(HEADING, 1)[1])[0]

# The inventory rows: | `function` | `service` | note |
rows = re.findall(r"(?m)^\|\s*`([A-Za-z0-9_$]+)`\s*\|", section)
if not rows:
    sys.exit(
        "check_deploy_service_list: found no function-inventory rows under "
        f"'{HEADING}'. Expected a table whose first column is a backticked "
        "function name."
    )
documented = set(rows)

missing = sorted(exports - documented)
stale = sorted(documented - exports)

for name in missing:
    print(
        f"FAIL: '{name}' is exported from functions/src/index.ts but is not "
        f"in the function inventory in DEPLOYMENT.md.",
        file=sys.stderr,
    )
for name in stale:
    print(
        f"FAIL: '{name}' is in the DEPLOYMENT.md function inventory but is "
        f"no longer exported from functions/src/index.ts.",
        file=sys.stderr,
    )

if missing or stale:
    print(
        f"\n      Update the table under {HEADING}.\n"
        "      For a NEW HTTP-triggered function, also run the invoker step\n"
        "      documented there once after its first deploy, or it will 403\n"
        "      every browser request at the CORS preflight. Do NOT run it\n"
        "      for an event-triggered function.",
        file=sys.stderr,
    )
    sys.exit(1)

print(
    f"check_deploy_service_list: OK ({len(exports)} exports, all accounted "
    "for in DEPLOYMENT.md)"
)
PY
