#!/usr/bin/env bash
# check_deploy_service_list (#441 follow-up)
#
# Every function exported from `functions/src/index.ts` must appear in
# the function-inventory table in DEPLOYMENT.md § Cloud Run IAM
# prerequisites.
#
# ## What went wrong that this catches
#
# HTTP-triggered functions need a manual `--no-invoker-iam-check` on
# first deploy: `firebase deploy` creates the Cloud Run service but
# cannot set its invoker policy. The function ships fine, the policy
# does not, and the callable then answers every browser request with a
# CORS-preflight 403 that the SDK reports as a bare `internal`. The
# documented list went stale the moment #441 added
# `deriveMatchEvidence`, and nothing noticed until the deploy failed.
#
# ## The default is failure
#
# Enumerating the export forms this understands proved open-ended:
# review on PR #452 surfaced bare and aliased re-exports, multi-symbol
# and multi-line clauses, local `export { foo }` with no `from`,
# wildcards, Firebase grouped exports, multi-binding declarations, and
# semicolon-less consecutive declarations — each round finding another
# valid shape that was silently skipped.
#
# So it is inverted: every `export` at statement position must match a
# supported form, and anything else EXITS NON-ZERO. A form this cannot
# parse is a loud build failure, not a quiet omission. That is what
# makes the accounting guarantee below actually a guarantee.
#
# ## Why this checks ACCOUNTING, not trigger type
#
# Earlier versions tried to infer which exports were HTTP-triggered and
# to generate the exact remediation command. Review on PR #452 found,
# in successive rounds, that this required correctly handling: bare and
# aliased re-exports, multi-symbol and multi-line export clauses, local
# `export { foo }` with no `from`, generic calls like
# `onCall<RequestData>(...)`, per-SYMBOL trigger resolution when one
# module exports both an HTTP and an event handler, the `_` -> `-`
# service-name rule, and per-function `region` options.
#
# Each fix was correct and the next round found another valid form. The
# honest reading is that "which binding becomes which service, where"
# is the TypeScript compiler's job plus firebase-tools' naming logic,
# and approximating it in CI produced a check that was confidently
# wrong in new ways — including, at one point, advising that an
# event-triggered function be made publicly invokable.
#
# So the contract is narrowed to something a text check can actually
# guarantee: every export is ACCOUNTED FOR in the table. The trigger
# type and service name are recorded there by a human, deliberately,
# which is also where that judgement belongs. This check only enforces
# that nobody adds a function and forgets.
#
# Fails closed on a missing heading, a missing table, or zero parsed
# exports — a check that cannot see its inputs must not report OK.
#
# Portability: stock macOS Bash 3.2 + python3 (five sibling checks here
# already use python3).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

python3 - "$ROOT" <<'PY'
import os, re, sys

root = sys.argv[1]
index_path = os.path.join(root, "functions", "src", "index.ts")
doc_path = os.path.join(root, "DEPLOYMENT.md")

for p in (index_path, doc_path):
    if not os.path.isfile(p):
        sys.exit(f"check_deploy_service_list: missing {os.path.relpath(p, root)}")

def strip_comments(text):
    text = re.sub(r"/\*.*?\*/", "", text, flags=re.S)
    return re.sub(r"(?m)//.*$", "", text)

src = strip_comments(open(index_path, encoding="utf-8").read())

# Every `export` at statement position, sliced to the next one. NOT
# split on `;`: TypeScript does not require them, so consecutive
# semicolon-less declarations landed in one chunk and everything after
# the first was silently dropped. CodeRabbit on PR #452.
# Statement position = start of file, or the first token after a
# newline, `;` or `}`. Anchoring on line-start alone missed
# `const x = 1; export { x };` written on one line.
starts = []
for m in re.finditer(r"\bexport\b", src):
    prefix = src[: m.start()].rstrip()
    if prefix == "" or prefix[-1] in ";}\n":
        starts.append(m.start())
if not starts:
    sys.exit(
        "check_deploy_service_list: no `export` statements found in "
        "functions/src/index.ts — failing rather than reporting a vacuous "
        "pass."
    )
chunks = [
    src[a : (starts[i + 1] if i + 1 < len(starts) else len(src))].strip()
    for i, a in enumerate(starts)
]

def top_level_comma(text):
    """A comma outside brackets, quotes and template literals."""
    depth = 0
    quote = None
    prev = ""
    for ch in text:
        if quote:
            if ch == quote and prev != "\\":
                quote = None
        elif ch in "\"'`":
            quote = ch
        elif ch in "([{<":
            depth += 1
        elif ch in ")]}>":
            depth -= 1
        elif ch == "," and depth <= 0:
            return True
        prev = ch
    return False

exports = set()
for st in chunks:
    # `export * ...` — an unknown set of bindings behind one statement.
    if re.match(r"^export\s+\*", st):
        sys.exit(
            "check_deploy_service_list: wildcard re-export found in "
            "functions/src/index.ts:\n"
            f"        {st.splitlines()[0][:100]}\n"
            "      This check cannot enumerate what a wildcard exports, so "
            "it fails rather than\n"
            "      report an accounting guarantee it cannot make. Name the "
            "exports explicitly."
        )

    # `export type { ... }` / `export type X = ...` — not functions.
    if re.match(r"^export\s+(type|interface)\b", st):
        continue

    # `export { A, B as C } [from "..."]`
    m = re.match(r"^export\s*\{(.+?)\}", st, flags=re.S)
    if m:
        for part in m.group(1).split(","):
            part = part.strip()
            if not part or part.startswith("type "):
                continue
            alias = re.match(r"^([A-Za-z0-9_$]+)\s+as\s+([A-Za-z0-9_$]+)$", part)
            name = alias.group(2) if alias else part
            if re.match(r"^[A-Za-z0-9_$]+$", name) and name != "default":
                exports.add(name)
        continue

    # `export const X = ...` / `export function X(...)` / `export class X`
    m = re.match(
        r"^export\s+(?:async\s+)?(?:const|let|var|function|class)\s+([A-Za-z0-9_$]+)",
        st,
    )
    if m:
        name = m.group(1)
        decl = re.match(r"^export\s+(?:async\s+)?(const|let|var)\s", st)
        if decl:
            # Firebase's grouped-export shape publishes `x-member`, not
            # `x`. Recording `x` documents a service that will not exist.
            if re.match(
                r"^export\s+(?:async\s+)?(?:const|let|var)\s+[A-Za-z0-9_$]+\s*=\s*\{",
                st,
            ):
                sys.exit(
                    f"check_deploy_service_list: '{name}' looks like a "
                    "Firebase grouped export (`export const x = { ... }`), "
                    "which publishes endpoints as `x-member`, not `x`.\n"
                    "      This check cannot enumerate group members, so it "
                    "fails rather than record a service name that will not "
                    "exist. Export the functions individually, or extend "
                    "this check to walk the group."
                )
            # `export const a = ..., b = ...` declares TWO endpoints.
            # Detecting the second reliably means parsing expressions, so
            # refuse the form instead. Codex P2 on PR #452.
            if top_level_comma(st):
                sys.exit(
                    f"check_deploy_service_list: '{name}' is part of a "
                    "multi-binding declaration (`export const a = ..., b = "
                    "...`).\n"
                    "      Each binding becomes its own Cloud Run service "
                    "and this check will not\n"
                    "      guess at the rest. Split it into one `export "
                    "const` per function."
                )
        exports.add(name)
        continue

    # Anything else is a form this check does not understand. Refusing
    # is the whole point: enumerating supported forms is open-ended and
    # kept missing new ones, so the default must be failure rather than
    # a silent skip. CodeRabbit on PR #452.
    sys.exit(
        "check_deploy_service_list: unrecognised export form in "
        "functions/src/index.ts:\n"
        f"        {st.splitlines()[0][:100]}\n"
        "      This check accounts for every export or fails; it does not "
        "skip what it\n"
        "      cannot parse. Rewrite it in a supported form, or teach this "
        "check the shape."
    )

if not exports:
    sys.exit(
        "check_deploy_service_list: parsed no exports from "
        "functions/src/index.ts — failing rather than reporting a vacuous "
        "pass."
    )

doc = open(doc_path, encoding="utf-8").read()
HEADING = "## Cloud Run IAM prerequisites (Functions)"
if HEADING not in doc:
    sys.exit(
        f"check_deploy_service_list: '{HEADING}' not found in DEPLOYMENT.md. "
        "The inventory moved or was renamed; this check will not pass by "
        "default."
    )
section = re.split(r"(?m)^## ", doc.split(HEADING, 1)[1])[0]

# Narrow again to the inventory SUBSECTION and its FIRST table.
# Scoping to the H2 alone was still too loose: an unrelated table later
# in the same section — troubleshooting, examples — could supply a name
# the inventory had lost, masking exactly the drift this exists to
# catch. Reproduced in review. Codex P2 on PR #452.
SUBHEADING = "### Function inventory"
if SUBHEADING not in section:
    sys.exit(
        f"check_deploy_service_list: '{SUBHEADING}' not found under "
        f"'{HEADING}'. The inventory moved or was renamed; this check will "
        "not pass by default."
    )
inventory = re.split(r"(?m)^#{2,3} ", section.split(SUBHEADING, 1)[1])[0]

# The first contiguous run of table rows in that subsection.
table_lines = []
seen_table = False
for line in inventory.splitlines():
    if line.lstrip().startswith("|"):
        seen_table = True
        table_lines.append(line)
    elif seen_table and line.strip() == "":
        continue
    elif seen_table:
        break

rows = re.findall(r"(?m)^\|\s*`([A-Za-z0-9_$]+)`\s*\|", "\n".join(table_lines))
if not rows:
    sys.exit(
        "check_deploy_service_list: found no function-inventory rows under "
        f"'{SUBHEADING}'. Expected a table whose first column is a "
        "backticked function name."
    )
documented = set(rows)

missing = sorted(exports - documented)
stale = sorted(documented - exports)

for name in missing:
    print(
        f"FAIL: '{name}' is exported from functions/src/index.ts but is not "
        f"in the function inventory in DEPLOYMENT.md.",
        file=sys.stderr,
    )
for name in stale:
    print(
        f"FAIL: '{name}' is in the DEPLOYMENT.md function inventory but is "
        f"no longer exported from functions/src/index.ts.",
        file=sys.stderr,
    )

if missing or stale:
    print(
        f"\n      Update the table under {HEADING}.\n"
        "      For a NEW HTTP-triggered function, also run the invoker step\n"
        "      documented there once after its first deploy, or it will 403\n"
        "      every browser request at the CORS preflight. Do NOT run it\n"
        "      for an event-triggered function.",
        file=sys.stderr,
    )
    sys.exit(1)

print(
    f"check_deploy_service_list: OK ({len(exports)} exports, all accounted "
    "for in DEPLOYMENT.md)"
)
PY
