rules_version = '2';

// Matchline V1 is single-user. Every document must carry `owner_uid`
// matching the authenticated user. The rules here enforce that invariant
// at the data layer; service-layer code MUST scope list queries via
// `ownerScope()` in src/services/auth.ts so the query constraint
// matches what these rules allow. Firestore evaluates list-query rules
// against the query constraint, not the returned documents — an
// unscoped list query will be rejected wholesale.
//
// This file intentionally locks everything down until owner_uid is wired
// through the data model. Sprint 0 scaffolding does not perform live
// reads; Sprint 1 must add owner_uid to every schema and update these
// rules together (see plan § Phase 1 c1).

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && resource.data.owner_uid == request.auth.uid;
    }
    function isCreatingAsOwner() {
      return request.auth != null
        && request.resource.data.owner_uid == request.auth.uid;
    }

    match /{collection}/{docId} {
      allow read: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if isOwner() && isCreatingAsOwner();
      allow delete: if isOwner();
    }
  }
}
