rules_version = '2';

// Matchline V1 is single-user. Every document must carry `owner_uid`
// matching the authenticated user, AND that user must be on the owner
// allowlist (`config/access.owner_uids`, see below). Service-layer code MUST scope
// list queries via `ownerScope()` in src/services/auth.ts so the query
// constraint matches what these rules allow. Firestore evaluates
// list-query rules against the query constraint, not the returned
// documents — an unscoped list query will be rejected wholesale.
//
// Every collection is matched explicitly. There is no catch-all
// `/{collection}/{docId}` match: a path not named below is denied, so
// a signed-in user cannot create documents in arbitrary collections
// (#439 hardening). Adding a collection means adding a block here and
// a row to `tests/firestore-rules.test.ts`.
//
// Admin-SDK writes (Cloud Functions) bypass these rules entirely. The
// "server-only" collections below are written exclusively by the
// functions; the rules exist to keep clients out of them.

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      // Null-guard `resource` and `resource.data` before the
      // owner_uid comparison. Without these, the rules engine
      // throws "Null value error" on any delete evaluation
      // where the doc isn't visible (nonexistent-doc deletes,
      // and observed flakily during cross-project emulator
      // contention — see #92). Strictly more restrictive than
      // the prior version: null resource → false instead of
      // an evaluation error.
      return isAllowlistedOwner()
        && resource != null
        && resource.data != null
        && resource.data.owner_uid == request.auth.uid;
    }
    function isCreatingAsOwner() {
      return isAllowlistedOwner()
        && request.resource.data.owner_uid == request.auth.uid;
    }

    // The owner allowlist (#439). V1 is single-user, but Firebase Auth
    // admits any account that can sign in — Google SSO alone accepts
    // every Google account — so "signed in" cannot be the authorization
    // rule. A caller is an owner only if their uid is listed in the
    // single fixed document `config/access` (`owner_uids: [uid, ...]`).
    //
    // Why ONE fixed document rather than a doc per owner: the rules this
    // file replaces had a catch-all match that let any signed-in user
    // create a document in any collection. A per-uid allowlist
    // (`owners/{uid}`) would have trusted any such document written
    // before this deploy, turning a pre-seeded entry into permanent
    // access. `config/access` is instead written by
    // `functions/scripts/set-owner-allowlist.ts` with a full-overwrite
    // Admin SDK `set()` as part of the deploy, which replaces whatever
    // a client may have put there beforehand. No client can read or
    // write `config/` under these rules.
    //
    // The callables enforce the same boundary independently via the
    // `MATCHLINE_OWNER_UIDS` function param
    // (functions/src/callables/ownerGate.ts); the script writes this
    // document from that same value. DEPLOYMENT.md § Owner allowlist.
    //
    // A missing document, or a missing / non-list `owner_uids`, admits
    // nobody. `exists()` + `get()` of one document are billed as reads
    // once per request evaluation, shared across every call in it.
    function isAllowlistedOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/access)
        && request.auth.uid in get(/databases/$(database)/documents/config/access).data.get('owner_uids', []);
    }

    // Standard owner-scoped CRUD for collections the client owns
    // outright. `update` requires both the stored and the written
    // owner_uid to be the caller's, so ownership cannot be handed off.
    function canUpdateAsOwner() {
      return isOwner() && isCreatingAsOwner();
    }

    // Reject any unitMatches write that produces the
    // contradictory `(approved_for_use: true, user_rejected:
    // true)` flag pair. The unified service-layer setter
    // (`setMatchApprovalState`, cursor #133 r1) and the
    // matching pipeline's carry-forward canonicalization
    // (cursor #133 r3) make the bad shape unrepresentable
    // through the V1 write paths, but `upsertMatch` can still
    // produce it. This rule is the boundary for CLIENT-side
    // (web/mobile SDK) writes ONLY.
    //
    // IMPORTANT: Firestore Security Rules do NOT apply to
    // Admin-SDK / server-credential writes — those bypass
    // rules entirely (https://firebase.google.com/docs/
    // firestore/security/overview). The matching pipeline's
    // `replaceMatchesForRole` (functions/src/matching/
    // pipeline.ts) writes `unitMatches` via `getAdminDb()`
    // inside a transaction and is therefore NOT subject to
    // this guard. On that path the ONLY thing preventing the
    // contradictory pair is the pipeline's own carry-forward
    // canonicalization (a service-layer invariant), not this
    // rule. Any NEW Cloud Function writing `unitMatches` must
    // replicate that code-level validation — this rule alone
    // will not catch it.
    //
    // Why it still matters for clients: generation gates on
    // `approved_for_use === true` and would consume a
    // contradictory match without this guard, silently
    // violating the user's rejection intent. cursor
    // CHANGES_REQUESTED round 4 on PR #133.
    //
    // The guard runs against `request.resource.data` (the
    // FINAL doc state after a partial update), so it catches
    // the violation whether the write was full or partial.
    // (Only `update` reaches it now: client creates of
    // unitMatches are closed — see `match /unitMatches`.)
    function isValidUnitMatchWrite(collection) {
      // `.get(field, default)` rather than `.field` direct
      // access — rules-engine direct access throws on missing
      // keys, which would reject every write that doesn't
      // include both flag names. Defaulting to `false` for
      // absent fields means the contradictory pair is the ONLY
      // shape rejected.
      return collection != 'unitMatches'
        || !(request.resource.data.get('approved_for_use', false) == true
             && request.resource.data.get('user_rejected', false) == true);
    }

    // `schema_version` is the matching pipeline's attestation that
    // it produced a match row — notably that `rationale` was
    // generated under the axis-gated rule, which is what lets
    // `MatchCard` present the prose to the user as a claim (#444).
    // A provenance marker a client can write is not a provenance
    // marker, which is why clients cannot CREATE matches at all
    // (only the matching pipeline does, via the admin SDK) and may
    // UPDATE only their review decision (below).
    //
    // History: an earlier version allowed client creates without
    // `schema_version`, and conflating create and update predicates
    // shipped a P1 that rejected every approve/reject on a
    // pipeline-written row (Codex P1 on PR #450). With creates closed,
    // only the update predicate remains.

    // On update, a client may change ONLY its own review
    // decision. Everything else on a match is the matching
    // pipeline's output.
    //
    // An equality check on `schema_version` alone was not enough,
    // and the gap is the interesting one: preserving the marker
    // while rewriting `rationale` forges the claim just as
    // effectively. The version attests that the PIPELINE produced
    // the row and gated the prose; guarding the marker without
    // guarding what it attests to protects a label rather than a
    // fact. Codex P1 on PR #451.
    //
    // Restricting the affected keys is stronger than comparing
    // each attested field, and cannot rot as fields are added —
    // a new pipeline-written field is protected by default
    // instead of needing to be remembered here.
    //
    // This also closes the pre-existing forge on LEGACY rows: a
    // client could previously add `component_applicability` plus
    // arbitrary prose and reach `isRationaleTrustworthy`'s
    // #435-era bridge. `setMatchApprovalState` is the only
    // production writer and touches exactly these two fields;
    // `upsertMatch` has no production caller.
    function isMatchUpdateApprovalOnly(collection) {
      return collection != 'unitMatches'
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['approved_for_use', 'user_rejected']);
    }

    // `config/*` (including the allowlist `config/access`) has no match
    // block: clients can neither read nor write it. Only the Admin SDK,
    // which bypasses rules, maintains it.

    // -- Client-owned collections: owner-scoped CRUD ---------------------

    match /people/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if canUpdateAsOwner();
    }

    match /companies/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if canUpdateAsOwner();
    }

    match /interactions/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if canUpdateAsOwner();
    }

    match /roles/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if canUpdateAsOwner();
    }

    match /unitClusters/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner();
      allow update: if canUpdateAsOwner();
    }

    // -- experienceUnits --------------------------------------------------
    //
    // Clients create Units (`manualInsert`) and edit them
    // (`updateFields`, `setApproval`); extraction and re-embedding
    // write them server-side. `embedding` is server-owned: it is what
    // matching scores against, and it is only ever computed from the
    // Unit's own text by the extraction / re-embed pipelines. A client
    // may neither supply one on create nor touch it on update.
    //
    // Update is an allowlist of fields rather than a denylist so a new
    // server-written field is protected by default. The list is
    // `EditableFields` in src/services/experienceUnits.ts plus the
    // state-machine fields `setApproval` / `updateFields` write.
    match /experienceUnits/{docId} {
      allow read, delete: if isOwner();
      allow create: if isCreatingAsOwner()
        && !request.resource.data.keys().hasAny(['embedding']);
      allow update: if canUpdateAsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'raw_text', 'normalized_summary', 'source_type', 'source_ref',
          'unit_type', 'skills', 'tools', 'domains', 'seniority_signals',
          'scope_signals', 'business_outcomes', 'metrics', 'evidence_type',
          'confidence_score', 'date_range',
          'user_approved', 'rejected', 'flagged', 'reembed_pending',
          'updated_at'
        ]);
    }

    // -- applications ------------------------------------------------------
    //
    // The client creates an Application shell (`upsertApplication`)
    // and then edits the generated asset's content (edit / add /
    // remove / reorder / undo). Generation appends assets and
    // validation writes their status server-side.
    //
    // Create: only the shell's fields, and no assets — every asset is
    // born in the generation pipeline.
    //
    // Update: only `generated_assets` plus the pipeline-stage fields.
    // `approved_unit_ids` (the grounding snapshot generation reads) and
    // everything else is fixed after create. `generated_assets` may
    // not grow: a client edits assets the pipeline produced, it never
    // adds one.
    //
    // Known limit: rules cannot iterate a list, so the per-asset
    // `validation_status` / `validation_flags` inside
    // `generated_assets[]` are not rule-enforced here. The client
    // legitimately writes them — edits flip an asset to `stale`, and
    // undo (`restoreAssetState`) restores a prior snapshot's status —
    // so the export gate's trust in `passed` is a client-side
    // invariant, not a security boundary, for the (single, allowlisted)
    // owner.
    match /applications/{docId} {
      allow read, delete: if isOwner();
      // `id` is tolerated only as a copy of the document id: the
      // service layer's converter strips it on write, but a path that
      // skipped the converter must not be locked out for it.
      allow create: if isCreatingAsOwner()
        && request.resource.data.keys().hasOnly([
          'owner_uid', 'role_id', 'stage', 'applied_at',
          'last_activity_at', 'generated_assets', 'approved_unit_ids', 'id'
        ])
        && request.resource.data.get('id', docId) == docId
        && request.resource.data.get('generated_assets', []) == [];
      allow update: if canUpdateAsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'generated_assets', 'stage', 'applied_at', 'last_activity_at'
        ])
        && request.resource.data.get('generated_assets', []).size()
             <= resource.data.get('generated_assets', []).size();
    }

    // -- unitMatches -------------------------------------------------------
    //
    // Created, replaced and deleted only by the matching pipeline
    // (admin SDK). The client may read its matches and record its
    // review decision on one — nothing else.
    match /unitMatches/{docId} {
      allow read: if isOwner();
      allow update: if canUpdateAsOwner()
        && isValidUnitMatchWrite('unitMatches')
        && isMatchUpdateApprovalOnly('unitMatches');
    }

    // -- jobRequirementUnits ----------------------------------------------
    //
    // Created and deleted only by the JD parsing pipeline (admin SDK).
    // The owner may edit a parsed Requirement's content inline
    // (`specs/matchline.md` § Step 2; `upsertRequirement` in
    // src/services/roles.ts, a merge setDoc on an existing doc), so
    // updates are allowed but limited to the user-editable fields.
    // Identity and provenance (`owner_uid`, `role_id`, `id`,
    // `extracted_from`) and the server-computed `embedding` stay
    // server-owned: an allowlist of fields, so a new pipeline-written
    // field is protected by default.
    match /jobRequirementUnits/{docId} {
      allow read: if isOwner();
      allow update: if canUpdateAsOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'raw_text', 'normalized_requirement', 'category', 'keywords',
          'tools', 'domains', 'seniority_level', 'priority', 'must_have'
        ]);
    }

    // -- Server-only collections ------------------------------------------

    // `llm_calls` is the per-call cost ledger written by
    // functions/src/llm/cost.ts. No client surface reads it; listed
    // explicitly so the denial is visible rather than implicit.
    match /llm_calls/{docId} {
      allow read, write: if false;
    }
  }
}
