dist/
build/
.next/
.out/
functions/lib/
*.tsbuildinfo

# Environment and secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/
__pycache__/
*.pyc
.venv/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Editor
.vscode/
!.vscode/extensions.json
.idea/

# AI / agents (local state and runtime artifacts only)
# Shared config (settings.json, .cursor/rules/, etc.) remains committed
.claude/settings.local.json
.claude/launch.json
.claude/worktrees/
.cursor/cache/
.cursor/state/
.cursor/plans/

# Testing
coverage/
playwright-report/
test-results/

# Firebase
.firebase/

# Misc
tmp/
.cache/

# Phase 4b review-barrier markers: per-checkout runtime state, never
# repository content. A committed marker makes another machine inherit an
# already-expired wait and escalate instead of getting its own retry budget
# (raised on both #457 and #456 — the same mistake twice).
.mergepath/
