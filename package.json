{
  "name": "matchline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests --exclude=tests/firestore-rules.test.ts --exclude=tests/**/*.integration.test.ts --exclude=.claude/**",
    "test:watch": "vitest --exclude=tests/firestore-rules.test.ts --exclude=tests/**/*.integration.test.ts --exclude=.claude/**",
    "test:rules": "scripts/firebase/with-java.sh firebase emulators:exec --only firestore 'vitest run tests/firestore-rules.test.ts tests/rejected-exclusion.integration.test.ts tests/matching-replace.integration.test.ts tests/validation-fabrication.integration.test.ts tests/generation-persistence.integration.test.ts --exclude=.claude/**'",
    "eval": "tsx tests/eval/run.ts",
    "ontology:collect": "tsx scripts/ontology/collect-vocab.ts",
    "ontology:harvest-jd": "tsx scripts/ontology/harvest-jd-vocab.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "firebase": "^12.16.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.24.0",
    "globals": "^17.8.0",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
