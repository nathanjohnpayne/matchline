{
  "name": "matchline",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --passWithNoTests --exclude=tests/firestore-rules.test.ts --exclude=tests/**/*.integration.test.ts --exclude=.claude/**",
    "test:watch": "vitest --exclude=tests/firestore-rules.test.ts --exclude=tests/**/*.integration.test.ts --exclude=.claude/**",
    "test:rules": "scripts/firebase/with-java.sh firebase emulators:exec --only firestore 'vitest run tests/firestore-rules.test.ts tests/rejected-exclusion.integration.test.ts tests/matching-replace.integration.test.ts tests/validation-fabrication.integration.test.ts tests/generation-persistence.integration.test.ts --exclude=.claude/**'",
    "eval": "tsx tests/eval/run.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "firebase": "^12.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.18.0",
    "globals": "^17.6.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.22.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
